# Calibration size for the UNet's quantization: prompts x Euler steps of
# float-model images whose UNet inputs set the int8/int16 ranges. Qualcomm's
# default is 100 x 20. The smoke run (2 x 2) took ~7 s per prompt-step on the
# runner's CPU; 40 x 20 is 800 samples, inside the 6 h job limit.
SAMPLES=40
STEPS=20
# 1 publishes a release under TAG; 0 only builds.
PUBLISH=1
TAG=sd15-liberte-pixelartredmond-8elite-w8a16-v1
