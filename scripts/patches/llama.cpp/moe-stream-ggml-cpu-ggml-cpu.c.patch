--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1467,6 +1467,969 @@
     }
 }
 
+// expert cache
+//
+// For a mixture-of-experts model whose expert weights stay in the mapped
+// model file (LLAMA_EXPERT_CACHE_MB set, see llama-model-loader.cpp) and do
+// not fit in memory. Left to the page cache, every page fault pulls in a
+// readahead window of neighbouring experts the token does not use, and the
+// kernel evicts the experts that are used, so each token reads several times
+// the bytes it needs. Here, once routing has picked the experts, the missing
+// ones are requested together (MADV_WILLNEED on exactly their bytes, also for
+// the same layer's sibling gate/up/down tensors, which run next), copied into
+// an LRU cache of whole expert slices with a fixed budget, and the matrix
+// multiplication reads from the copies. Readahead is switched off for the
+// expert tensors (MADV_RANDOM) and the mapped pages are dropped once copied.
+//
+// Slices are read with pread from the file behind the mapping (found in
+// /proc/self/maps), one large read each, after posix_fadvise(WILLNEED) has
+// queued them all, and their page cache is dropped once copied. The op's
+// first thread decides what to read and allocates; every thread of the op
+// then reads its share (ggml_ec_run_reads), so the reads run in parallel
+// instead of one after another while the other threads wait. Copying out
+// of the mapping instead faults it in a page at a time once readahead is
+// off: on a phone, 1.26 million faults of ~7 KB for 9 GB, at 0.4 tok/s.
+// Prompt processing reads its pass-through slices the same way, into
+// buffers freed at the next op.
+//
+// The budget is LLAMA_EXPERT_CACHE_MB, capped when the cache is first used
+// (the model, context and compute buffers allocated by then) at the memory
+// still available less a reserve: a budget past that pushes the process
+// into swap and the low-memory killer.
+//
+// Prefetch (LLAMA_EXPERT_PREFETCH=<reader threads>): in generation, when a
+// layer's experts are about to run, the next layer's are guessed from this
+// layer's router input (rescaled by the two layers' ffn norms, then run
+// through the next layer's router, which llama-model.cpp hands over) and the
+// missing ones are queued for background reader threads. On LFM2.5-24B-A2B
+// the guess holds about 85% of the experts the next layer picks, so most
+// misses are in flight, many at once, before the layer asks. An entry being
+// read is never evicted; an op that needs one still queued reads it itself,
+// and waits for one a reader has started.
+
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#define GGML_EXPERT_CACHE 1
+#endif
+
+#ifdef GGML_EXPERT_CACHE
+
+struct ggml_ec_entry {
+    void *     data;
+    uint64_t   used;       // tick of the last use
+    uint64_t   pin;        // op serial that needs it now
+    atomic_int state;      // GGML_EC_READY, or a prefetch queued or being read into data
+    bool       prefetched; // read ahead and not used yet
+};
+
+enum {
+    GGML_EC_READY   = 0,
+    GGML_EC_QUEUED  = 1,
+    GGML_EC_READING = 2,
+};
+
+struct ggml_ec_tensor {
+    const void * base;   // src0->data in the mapping
+    const void * buffer; // src0->buffer, told apart from a later model at the same address
+    size_t       slice;  // bytes per expert
+    int          n;      // experts
+    int          layer;  // from the name "blk.N.ffn_*_exps", -1 if none
+    int          fd;     // the mapped file, read with pread; -1: copy from the mapping
+    int64_t      off;    // file offset of base
+    struct ggml_ec_entry * e;
+};
+
+#define GGML_EC_MAX_TENSORS 1024
+
+static struct {
+    size_t   budget;
+    size_t   requested; // LLAMA_EXPERT_CACHE_MB, the budget before the cap
+    size_t   avail;     // MemAvailable when the budget was set
+    size_t   used;
+    uint64_t tick;
+    uint64_t serial;
+    int      n_tensors;
+    struct ggml_ec_tensor t[GGML_EC_MAX_TENSORS];
+    uint64_t hits, misses;
+} g_ec;
+
+// Slices read straight from the mapping by the last pass-through op, dropped
+// at the next prepare: by then every thread is past that op (ggml-cpu runs a
+// barrier between nodes).
+#define GGML_EC_MAX_PENDING 1024
+// `buf` is set when the slice was read into a buffer of its own (freed then),
+// else the mapped bytes are advised away.
+static struct { const void * p; size_t n; void * buf; } g_ec_pending[GGML_EC_MAX_PENDING];
+static int g_ec_n_pending;
+
+// Reads the current op needs, filled by ggml_ec_prepare and done by every
+// thread of the op (ggml_ec_run_reads) before any of them computes.
+#define GGML_EC_MAX_READS 1024
+// `e` is set for a queued prefetch taken over by the op, marked ready once read.
+static struct { const struct ggml_ec_tensor * t; int a; void * dst; struct ggml_ec_entry * e; } g_ec_reads[GGML_EC_MAX_READS];
+static int g_ec_n_reads;
+
+// prefetches the current op needs that a reader thread is still reading
+static struct ggml_ec_entry * g_ec_waits[GGML_EC_MAX_READS];
+static int g_ec_n_waits;
+
+// files behind the expert mappings, opened once each
+#define GGML_EC_MAX_FILES 16
+static struct { char path[512]; int fd; } g_ec_files[GGML_EC_MAX_FILES];
+static int g_ec_n_files;
+
+// for the stats file (ggml_ec_write_stats)
+static int g_ec_last_layer = -1;
+static int g_ec_n_layers;   // highest layer seen + 1
+static uint64_t g_ec_read_bytes, g_ec_passthrough;
+// slices read ahead; of those, used later, used while still being read, and
+// evicted without being used
+static uint64_t g_ec_prefetched, g_ec_prefetch_used, g_ec_prefetch_late, g_ec_prefetch_wasted;
+
+// Where a generated token's time goes, for the stats file: thread 0's wall
+// clock (ns) per kind of node, each node timed up to the barrier after it, so
+// it includes waiting for the slowest thread. Only graphs that ran an expert
+// op on a generation-sized batch count (g_ec_graph_gen); gap is the time
+// between two such graphs, outside the CPU backend (llama.cpp's own work,
+// sampling, the app). Within the expert ops: prep is the first thread
+// deciding what to read (and the prefetch guess), reads is the op's own
+// reads plus waiting for prefetches still being read.
+enum {
+    GGML_EC_T_GRAPH,
+    GGML_EC_T_EXPERTS,
+    GGML_EC_T_PREP,
+    GGML_EC_T_READS,
+    GGML_EC_T_MATMUL,
+    GGML_EC_T_ATTN,
+    GGML_EC_T_OTHER,
+    GGML_EC_T_GAP,
+    GGML_EC_T_N,
+};
+static uint64_t g_ec_time[GGML_EC_T_N];   // generation graphs so far
+static uint64_t g_ec_graph_time[GGML_EC_T_N]; // the graph running now
+static uint64_t g_ec_gen_graphs;
+static uint64_t g_ec_last_gen_end;        // when the last generation graph ended, 0 if none yet
+static bool     g_ec_graph_gen;
+static bool     g_ec_timing;              // stats file set: time this graph
+
+static uint64_t ggml_ec_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec*1000000000ull + (uint64_t) ts.tv_nsec;
+}
+
+static size_t ggml_ec_page(void) {
+    static size_t page = 0;
+    if (!page) {
+        long p = sysconf(_SC_PAGESIZE);
+        page = p > 0 ? (size_t) p : 4096;
+    }
+    return page;
+}
+
+// whole pages inside [p, p + n), so the advice never reaches a neighbour
+static void ggml_ec_advise(const void * p, size_t n, int advice) {
+    const size_t page = ggml_ec_page();
+    uintptr_t beg = ((uintptr_t) p + page - 1) & ~(uintptr_t)(page - 1);
+    uintptr_t end = ((uintptr_t) p + n) & ~(uintptr_t)(page - 1);
+    if (end > beg) {
+        madvise((void *) beg, end - beg, advice);
+    }
+}
+
+// the whole pages covering [p, p + n): for reading ahead
+static void ggml_ec_willneed(const void * p, size_t n) {
+    const size_t page = ggml_ec_page();
+    uintptr_t beg = (uintptr_t) p & ~(uintptr_t)(page - 1);
+    uintptr_t end = ((uintptr_t) p + n + page - 1) & ~(uintptr_t)(page - 1);
+    madvise((void *) beg, end - beg, MADV_WILLNEED);
+}
+
+static size_t ggml_ec_budget(void) {
+    const char * env = getenv("LLAMA_EXPERT_CACHE_MB");
+    if (!env) {
+        return 0;
+    }
+    long long mb = atoll(env);
+    return mb > 0 ? (size_t) mb * 1024 * 1024 : 0;
+}
+
+// MemAvailable in bytes, 0 if unknown
+static size_t ggml_ec_mem_available(void) {
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (!f) {
+        return 0;
+    }
+    char line[256];
+    unsigned long long kb = 0;
+    while (fgets(line, sizeof(line), f)) {
+        if (sscanf(line, "MemAvailable: %llu kB", &kb) == 1) {
+            break;
+        }
+    }
+    fclose(f);
+    return (size_t) kb * 1024;
+}
+
+// Left free beside the cache: the app, the slices a prompt passes through,
+// page cache in flight and everything else on the phone.
+// 1.25 GB still swapped on a phone (the cache faulted back in from zram
+// mid-benchmark at 1.6 GB free).
+#define GGML_EC_RESERVE ((size_t) 2048 * 1024 * 1024)
+#define GGML_EC_MIN     ((size_t)  256 * 1024 * 1024)
+
+// The requested budget capped at what is available now, the cache's own
+// slices counted as available (they are what it would give back).
+// LLAMA_EXPERT_CACHE_NO_CAP=1 keeps the requested budget.
+static size_t ggml_ec_effective_budget(size_t requested) {
+    const char * nocap = getenv("LLAMA_EXPERT_CACHE_NO_CAP");
+    if (nocap && strcmp(nocap, "0") != 0) {
+        g_ec.avail = 0;
+        return requested;
+    }
+    const size_t avail = ggml_ec_mem_available();
+    g_ec.avail = avail;
+    if (avail == 0) {
+        return requested;
+    }
+    const size_t room = avail + g_ec.used > GGML_EC_RESERVE ? avail + g_ec.used - GGML_EC_RESERVE : 0;
+    size_t budget = requested < room ? requested : room;
+    if (budget < GGML_EC_MIN) {
+        budget = requested < GGML_EC_MIN ? requested : GGML_EC_MIN;
+    }
+    if (budget != requested) {
+        GGML_LOG_INFO("%s: expert cache %zu MiB (asked %zu MiB, %zu MiB available)\n", __func__,
+                budget >> 20, requested >> 20, avail >> 20);
+    }
+    return budget;
+}
+
+// The file and offset behind a mapped address, from /proc/self/maps.
+static int ggml_ec_file_of(const void * addr, int64_t * off) {
+    FILE * f = fopen("/proc/self/maps", "r");
+    if (!f) {
+        return -1;
+    }
+    char line[1024];
+    char path[512];
+    int fd = -1;
+    const uintptr_t a = (uintptr_t) addr;
+    while (fgets(line, sizeof(line), f)) {
+        unsigned long long beg, end, moff;
+        path[0] = 0;
+        if (sscanf(line, "%llx-%llx %*s %llx %*s %*s %511s", &beg, &end, &moff, path) < 3) {
+            continue;
+        }
+        if (a < beg || a >= end) {
+            continue;
+        }
+        if (path[0] != '/') {
+            break; // anonymous: a copy, not a mapping
+        }
+        for (int i = 0; i < g_ec_n_files; i++) {
+            if (strcmp(g_ec_files[i].path, path) == 0) {
+                fd = g_ec_files[i].fd;
+            }
+        }
+        if (fd < 0 && g_ec_n_files < GGML_EC_MAX_FILES) {
+            fd = open(path, O_RDONLY | O_CLOEXEC);
+            if (fd >= 0) {
+                snprintf(g_ec_files[g_ec_n_files].path, sizeof(g_ec_files[0].path), "%s", path);
+                g_ec_files[g_ec_n_files].fd = fd;
+                g_ec_n_files++;
+            }
+        }
+        *off = (int64_t) (a - beg + moff);
+        break;
+    }
+    fclose(f);
+    return fd;
+}
+
+static void ggml_ec_fadvise(const struct ggml_ec_tensor * t, size_t at, size_t n, int advice) {
+    posix_fadvise(t->fd, (off_t) (t->off + (int64_t) at), (off_t) n, advice);
+}
+
+// queues the read of [at, at + n) of the tensor
+static void ggml_ec_prefetch(const struct ggml_ec_tensor * t, size_t at, size_t n) {
+    if (t->fd >= 0) {
+        ggml_ec_fadvise(t, at, n, POSIX_FADV_WILLNEED);
+    } else {
+        ggml_ec_willneed((const char *) t->base + at, n);
+    }
+}
+
+// Reads expert a's slice into dst, then drops its page cache; false on a
+// failed read (dst then holds nothing useful) or without a file.
+static bool ggml_ec_read(const struct ggml_ec_tensor * t, int a, void * dst) {
+    if (t->fd < 0) {
+        return false;
+    }
+    size_t done = 0;
+    while (done < t->slice) {
+        ssize_t r = pread(t->fd, (char *) dst + done, t->slice - done, (off_t) (t->off + (int64_t) (a*t->slice + done)));
+        if (r <= 0) {
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        done += (size_t) r;
+    }
+    ggml_ec_fadvise(t, a*t->slice, t->slice, POSIX_FADV_DONTNEED);
+    return true;
+}
+
+// expert a's slice into dst, by pread or else from the mapping
+static void ggml_ec_load(const struct ggml_ec_tensor * t, int a, void * dst) {
+    if (!ggml_ec_read(t, a, dst)) {
+        const char * mapped = (const char *) t->base + a*t->slice;
+        memcpy(dst, mapped, t->slice);
+        ggml_ec_advise(mapped, t->slice, MADV_DONTNEED);
+    }
+}
+
+// queues the read of expert a's slice into dst for the op's threads; read
+// at once when the queue is full
+static void ggml_ec_queue(const struct ggml_ec_tensor * t, int a, void * dst, struct ggml_ec_entry * e) {
+    if (g_ec_n_reads < GGML_EC_MAX_READS) {
+        g_ec_reads[g_ec_n_reads].t   = t;
+        g_ec_reads[g_ec_n_reads].a   = a;
+        g_ec_reads[g_ec_n_reads].dst = dst;
+        g_ec_reads[g_ec_n_reads].e   = e;
+        g_ec_n_reads++;
+    } else {
+        ggml_ec_load(t, a, dst);
+        if (e) {
+            atomic_store_explicit(&e->state, GGML_EC_READY, memory_order_release);
+        }
+    }
+}
+
+// Thread ith of nth does its share of the queued reads. Every thread of the
+// op calls it after the barrier that follows ggml_ec_prepare, and they meet
+// at another barrier before computing.
+static void ggml_ec_run_reads(int ith, int nth) {
+    for (int i = ith; i < g_ec_n_reads; i += nth) {
+        ggml_ec_load(g_ec_reads[i].t, g_ec_reads[i].a, g_ec_reads[i].dst);
+        if (g_ec_reads[i].e) {
+            atomic_store_explicit(&g_ec_reads[i].e->state, GGML_EC_READY, memory_order_release);
+        }
+    }
+}
+
+// prefetch reader threads, started on first use
+
+#define GGML_EC_MAX_JOBS    4096
+#define GGML_EC_MAX_READERS 16
+
+static struct { const struct ggml_ec_tensor * t; int a; } g_ec_jobs[GGML_EC_MAX_JOBS];
+static int g_ec_job_head, g_ec_job_count; // ring
+static int g_ec_job_running;              // taken by a reader, not finished
+static pthread_mutex_t g_ec_job_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  g_ec_job_cond  = PTHREAD_COND_INITIALIZER; // a job was queued
+static pthread_cond_t  g_ec_done_cond = PTHREAD_COND_INITIALIZER; // a job finished
+static int g_ec_n_readers;
+
+static void * ggml_ec_reader(void * arg) {
+    GGML_UNUSED(arg);
+    pthread_mutex_lock(&g_ec_job_mutex);
+    for (;;) {
+        while (g_ec_job_count == 0) {
+            pthread_cond_wait(&g_ec_job_cond, &g_ec_job_mutex);
+        }
+        const struct ggml_ec_tensor * t = g_ec_jobs[g_ec_job_head].t;
+        const int a = g_ec_jobs[g_ec_job_head].a;
+        g_ec_job_head = (g_ec_job_head + 1) % GGML_EC_MAX_JOBS;
+        g_ec_job_count--;
+        g_ec_job_running++;
+        pthread_mutex_unlock(&g_ec_job_mutex);
+
+        // an op may have taken it over since it was queued
+        struct ggml_ec_entry * e = &t->e[a];
+        int queued = GGML_EC_QUEUED;
+        if (atomic_compare_exchange_strong_explicit(&e->state, &queued, GGML_EC_READING,
+                                                    memory_order_acquire, memory_order_relaxed)) {
+            ggml_ec_load(t, a, e->data);
+            atomic_store_explicit(&e->state, GGML_EC_READY, memory_order_release);
+        }
+
+        pthread_mutex_lock(&g_ec_job_mutex);
+        g_ec_job_running--;
+        pthread_cond_broadcast(&g_ec_done_cond);
+    }
+    return NULL;
+}
+
+// reader threads asked for, 0 when prefetch is off
+static int ggml_ec_prefetch_threads(void) {
+    const char * env = getenv("LLAMA_EXPERT_PREFETCH");
+    const int n = env ? atoi(env) : 0;
+    return n < 0 ? 0 : n > GGML_EC_MAX_READERS ? GGML_EC_MAX_READERS : n;
+}
+
+// queues expert a's slice for a reader; false when that cannot be done
+static bool ggml_ec_push_job(const struct ggml_ec_tensor * t, int a) {
+    pthread_mutex_lock(&g_ec_job_mutex);
+    const int want = ggml_ec_prefetch_threads();
+    while (g_ec_n_readers < want) {
+        pthread_t th;
+        if (pthread_create(&th, NULL, ggml_ec_reader, NULL) != 0) {
+            break;
+        }
+        pthread_detach(th);
+        g_ec_n_readers++;
+    }
+    const bool ok = g_ec_n_readers > 0 && g_ec_job_count < GGML_EC_MAX_JOBS;
+    if (ok) {
+        const int i = (g_ec_job_head + g_ec_job_count) % GGML_EC_MAX_JOBS;
+        g_ec_jobs[i].t = t;
+        g_ec_jobs[i].a = a;
+        g_ec_job_count++;
+        pthread_cond_signal(&g_ec_job_cond);
+    }
+    pthread_mutex_unlock(&g_ec_job_mutex);
+    return ok;
+}
+
+// Waits until every slice in g_ec_waits is read. Called by one thread of the
+// op, between the barriers around the op's own reads.
+static void ggml_ec_wait_prefetched(void) {
+    pthread_mutex_lock(&g_ec_job_mutex);
+    for (int i = 0; i < g_ec_n_waits; i++) {
+        while (atomic_load_explicit(&g_ec_waits[i]->state, memory_order_acquire) != GGML_EC_READY) {
+            pthread_cond_wait(&g_ec_done_cond, &g_ec_job_mutex);
+        }
+    }
+    pthread_mutex_unlock(&g_ec_job_mutex);
+}
+
+// Drops the queued jobs and waits for the running ones, so that no reader
+// holds a slice about to be freed.
+static void ggml_ec_stop_jobs(void) {
+    pthread_mutex_lock(&g_ec_job_mutex);
+    g_ec_job_count = 0;
+    while (g_ec_job_running > 0) {
+        pthread_cond_wait(&g_ec_done_cond, &g_ec_job_mutex);
+    }
+    pthread_mutex_unlock(&g_ec_job_mutex);
+}
+
+// routers, for guessing the next layer's experts
+
+#define GGML_EC_MAX_LAYERS 512
+
+static struct ggml_ec_router {
+    const void *  owner;  // the model
+    const float * w;      // [n_expert][n_embd]
+    const float * norm;   // [n_embd] ffn norm weights, or NULL
+    const float * bias;   // [n_expert] selection bias, or NULL
+    int           n_embd;
+    int           n_expert;
+    int           gating; // llama_expert_gating_func_type
+    int           n_used;
+} g_ec_routers[GGML_EC_MAX_LAYERS];
+
+static const float * ggml_ec_host_f32(const struct ggml_tensor * t, int64_t n) {
+    if (!t || t->type != GGML_TYPE_F32 || !t->data || ggml_nelements(t) != n || !ggml_is_contiguous(t) ||
+        (t->buffer && !ggml_backend_buffer_is_host(t->buffer))) {
+        return NULL;
+    }
+    return (const float *) t->data;
+}
+
+void ggml_cpu_expert_cache_set_router(const void * owner, int layer, const struct ggml_tensor * gate_inp,
+                                      const struct ggml_tensor * norm, const struct ggml_tensor * bias,
+                                      int gating, int n_used) {
+    if (layer < 0 || layer >= GGML_EC_MAX_LAYERS || !gate_inp || gate_inp->ne[2] != 1 || gate_inp->ne[3] != 1) {
+        return;
+    }
+    const int n_embd   = (int) gate_inp->ne[0];
+    const int n_expert = (int) gate_inp->ne[1];
+    const float * w = ggml_ec_host_f32(gate_inp, (int64_t) n_embd * n_expert);
+    if (!w || n_used <= 0 || n_used > n_expert) {
+        return;
+    }
+    ggml_critical_section_start();
+    struct ggml_ec_router * r = &g_ec_routers[layer];
+    r->owner    = owner;
+    r->w        = w;
+    r->norm     = ggml_ec_host_f32(norm, n_embd);
+    r->bias     = ggml_ec_host_f32(bias, n_expert);
+    r->n_embd   = n_embd;
+    r->n_expert = n_expert;
+    r->gating   = gating;
+    r->n_used   = n_used;
+    ggml_critical_section_end();
+}
+
+void ggml_cpu_expert_cache_forget_routers(const void * owner) {
+    ggml_critical_section_start();
+    for (int i = 0; i < GGML_EC_MAX_LAYERS; i++) {
+        if (g_ec_routers[i].owner == owner) {
+            memset(&g_ec_routers[i], 0, sizeof(g_ec_routers[i]));
+        }
+    }
+    ggml_critical_section_end();
+}
+
+static void ggml_ec_free_tensor(struct ggml_ec_tensor * t) {
+    for (int i = 0; i < t->n; i++) {
+        if (t->e[i].data) {
+            free(t->e[i].data);
+            g_ec.used -= t->slice;
+        }
+    }
+    free(t->e);
+    t->e = NULL;
+}
+
+void ggml_cpu_expert_cache_clear(void) {
+    ggml_ec_stop_jobs();
+    ggml_critical_section_start();
+    for (int i = 0; i < g_ec.n_tensors; i++) {
+        ggml_ec_free_tensor(&g_ec.t[i]);
+    }
+    g_ec.n_tensors = 0;
+    g_ec.used = 0;
+    g_ec.budget = g_ec.requested = 0;
+    g_ec.hits = g_ec.misses = 0;
+    for (int i = 0; i < g_ec_n_pending; i++) {
+        free(g_ec_pending[i].buf);
+    }
+    g_ec_n_pending = 0;
+    for (int i = 0; i < g_ec_n_files; i++) {
+        close(g_ec_files[i].fd);
+    }
+    g_ec_n_files = 0;
+    g_ec_last_layer = -1;
+    g_ec_n_layers = 0;
+    g_ec_read_bytes = g_ec_passthrough = 0;
+    g_ec_prefetched = g_ec_prefetch_used = g_ec_prefetch_late = g_ec_prefetch_wasted = 0;
+    memset(g_ec_time, 0, sizeof(g_ec_time));
+    g_ec_gen_graphs = 0;
+    g_ec_last_gen_end = 0;
+    ggml_critical_section_end();
+}
+
+void ggml_cpu_expert_cache_stats(uint64_t * hits, uint64_t * misses, size_t * used, size_t * budget) {
+    if (hits)   *hits   = g_ec.hits;
+    if (misses) *misses = g_ec.misses;
+    if (used)   *used   = g_ec.used;
+    if (budget) *budget = g_ec.budget;
+}
+
+static struct ggml_ec_tensor * ggml_ec_find(const struct ggml_tensor * src0, bool add) {
+    for (int i = 0; i < g_ec.n_tensors; i++) {
+        struct ggml_ec_tensor * t = &g_ec.t[i];
+        if (t->base == src0->data && t->buffer == (const void *) src0->buffer) {
+            return t;
+        }
+    }
+    if (!add || g_ec.n_tensors == GGML_EC_MAX_TENSORS) {
+        return NULL;
+    }
+    struct ggml_ec_tensor * t = &g_ec.t[g_ec.n_tensors];
+    t->e = calloc((size_t) src0->ne[2], sizeof(struct ggml_ec_entry));
+    if (!t->e) {
+        return NULL;
+    }
+    t->base   = src0->data;
+    t->buffer = src0->buffer;
+    t->slice  = src0->nb[2];
+    t->n      = (int) src0->ne[2];
+    t->layer  = -1;
+    int layer;
+    if (sscanf(src0->name, "blk.%d.", &layer) == 1 && strstr(src0->name, "_exps") != NULL) {
+        t->layer = layer;
+    }
+    t->off = 0;
+    t->fd  = ggml_ec_file_of(src0->data, &t->off);
+    g_ec.n_tensors++;
+    // the cache decides what is read; the kernel's readahead would only
+    // bring in neighbouring experts
+    ggml_ec_advise(src0->data, ggml_nbytes(src0), MADV_RANDOM);
+    return t;
+}
+
+// frees least recently used slices not needed by the current op, and not
+// being read, until `need` more bytes fit; false when they cannot
+static bool ggml_ec_make_room(size_t need) {
+    while (g_ec.used + need > g_ec.budget) {
+        struct ggml_ec_tensor * best_t = NULL;
+        int best_i = -1;
+        uint64_t best = UINT64_MAX;
+        for (int i = 0; i < g_ec.n_tensors; i++) {
+            struct ggml_ec_tensor * t = &g_ec.t[i];
+            for (int j = 0; j < t->n; j++) {
+                struct ggml_ec_entry * e = &t->e[j];
+                if (e->data && e->pin != g_ec.serial && e->used < best &&
+                    atomic_load_explicit(&e->state, memory_order_relaxed) == GGML_EC_READY) {
+                    best = e->used;
+                    best_t = t;
+                    best_i = j;
+                }
+            }
+        }
+        if (!best_t) {
+            return false;
+        }
+        struct ggml_ec_entry * e = &best_t->e[best_i];
+        if (e->prefetched) {
+            g_ec_prefetch_wasted++;
+            e->prefetched = false;
+        }
+        free(e->data);
+        e->data = NULL;
+        g_ec.used -= best_t->slice;
+    }
+    return true;
+}
+
+// Guesses layer `t->layer + 1`'s experts for the tokens in src1 (this layer's
+// router input, [n_embd, 1, n_tokens]) and queues the missing slices of that
+// layer's expert tensors for the reader threads.
+static void ggml_ec_prefetch_next(const struct ggml_ec_tensor * t, const struct ggml_tensor * src1) {
+    const int next = t->layer + 1;
+    if (t->layer < 0 || next >= GGML_EC_MAX_LAYERS) {
+        return;
+    }
+    const struct ggml_ec_router * rc = &g_ec_routers[t->layer];
+    const struct ggml_ec_router * rn = &g_ec_routers[next];
+    const int n_embd = rn->n_embd, n_expert = rn->n_expert;
+    if (!rn->w || n_expert != t->n || src1->type != GGML_TYPE_F32 || src1->ne[0] != n_embd || src1->ne[1] != 1 ||
+        src1->ne[3] != 1 || src1->nb[0] != sizeof(float)) {
+        return;
+    }
+    // the input is this layer's ffn norm output: undo its weights, apply the next layer's
+    const bool rescale = rc->w && rc->n_embd == n_embd && rc->norm && rn->norm;
+
+    const char * env_k = getenv("LLAMA_EXPERT_PREFETCH_TOPK");
+    int k = env_k ? atoi(env_k) : rn->n_used;
+    k = k < 1 ? 1 : k > n_expert ? n_expert : k;
+
+    float x[8192];
+    float score[512];
+    bool want[512] = { false };
+    if (n_embd > 8192 || n_expert > 512) {
+        return;
+    }
+    for (int64_t tok = 0; tok < src1->ne[2]; tok++) {
+        const float * in = (const float *) ((const char *) src1->data + tok*src1->nb[2]);
+        for (int i = 0; i < n_embd; i++) {
+            x[i] = rescale ? (rc->norm[i] != 0.0f ? in[i] / rc->norm[i] * rn->norm[i] : 0.0f) : in[i];
+        }
+        float max = -INFINITY;
+        for (int e = 0; e < n_expert; e++) {
+            const float * w = rn->w + (size_t) e*n_embd;
+            float acc = 0.0f;
+            for (int i = 0; i < n_embd; i++) {
+                acc += w[i]*x[i];
+            }
+            score[e] = acc;
+            max = MAX(max, acc);
+        }
+        // as build_moe_ffn: probabilities, then the selection bias
+        if (rn->gating == 1) { // softmax
+            float sum = 0.0f;
+            for (int e = 0; e < n_expert; e++) {
+                score[e] = expf(score[e] - max);
+                sum += score[e];
+            }
+            for (int e = 0; e < n_expert; e++) {
+                score[e] /= sum;
+            }
+        } else if (rn->gating == 2) { // sigmoid
+            for (int e = 0; e < n_expert; e++) {
+                score[e] = 1.0f/(1.0f + expf(-score[e]));
+            }
+        }
+        if (rn->bias) {
+            for (int e = 0; e < n_expert; e++) {
+                score[e] += rn->bias[e];
+            }
+        }
+        for (int j = 0; j < k; j++) {
+            int best = -1;
+            for (int e = 0; e < n_expert; e++) {
+                if (score[e] != -INFINITY && (best < 0 || score[e] > score[best])) {
+                    best = e;
+                }
+            }
+            want[best] = true;
+            score[best] = -INFINITY;
+        }
+    }
+
+    for (int i = 0; i < g_ec.n_tensors; i++) {
+        struct ggml_ec_tensor * s = &g_ec.t[i];
+        if (s->layer != next || s->buffer != t->buffer || s->n != n_expert) {
+            continue;
+        }
+        for (int a = 0; a < n_expert; a++) {
+            if (!want[a]) {
+                continue;
+            }
+            struct ggml_ec_entry * e = &s->e[a];
+            if (e->data) {
+                e->used = ++g_ec.tick; // keep it for the next layer
+                continue;
+            }
+            if (!ggml_ec_make_room(s->slice) || (e->data = malloc(s->slice)) == NULL) {
+                return;
+            }
+            e->used = ++g_ec.tick;
+            e->prefetched = true;
+            g_ec.used += s->slice;
+            atomic_store_explicit(&e->state, GGML_EC_QUEUED, memory_order_release);
+            if (!ggml_ec_push_job(s, a)) {
+                // no reader: give the slot back
+                atomic_store_explicit(&e->state, GGML_EC_READY, memory_order_relaxed);
+                e->prefetched = false;
+                free(e->data);
+                e->data = NULL;
+                g_ec.used -= s->slice;
+                return;
+            }
+            ggml_ec_prefetch(s, a*s->slice, s->slice);
+            g_ec_prefetched++;
+            g_ec_read_bytes += s->slice;
+        }
+    }
+}
+
+static void ggml_ec_release_pending(void) {
+    for (int i = 0; i < g_ec_n_pending; i++) {
+        if (g_ec_pending[i].buf) {
+            free(g_ec_pending[i].buf);
+        } else {
+            ggml_ec_advise(g_ec_pending[i].p, g_ec_pending[i].n, MADV_DONTNEED);
+        }
+    }
+    g_ec_n_pending = 0;
+}
+
+// Counters for the app's log, written to LLAMA_EXPERT_CACHE_STATS_FILE at
+// the start of each pass through the model, and at each layer of a prompt's
+// pass so the app can show how far through the model a long prefill is:
+// layer (0-based) of layers, on a batch of `tokens`.
+static void ggml_ec_write_stats(int layer, int64_t tokens) {
+    const char * path = getenv("LLAMA_EXPERT_CACHE_STATS_FILE");
+    if (!path) {
+        return;
+    }
+    char tmp[1024];
+    snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+    FILE * f = fopen(tmp, "w");
+    if (!f) {
+        return;
+    }
+    int pread_tensors = 0;
+    for (int i = 0; i < g_ec.n_tensors; i++) {
+        pread_tensors += g_ec.t[i].fd >= 0;
+    }
+    fprintf(f, "{\"hits\":%llu,\"misses\":%llu,\"passthrough\":%llu,\"readMb\":%.1f,\"usedMb\":%.1f,\"budgetMb\":%.1f,"
+               "\"requestedMb\":%.1f,\"availMb\":%.1f,\"tensors\":%d,\"preadTensors\":%d,"
+               "\"layer\":%d,\"layers\":%d,\"tokens\":%lld,"
+               "\"prefetched\":%llu,\"prefetchUsed\":%llu,\"prefetchLate\":%llu,\"prefetchWasted\":%llu,"
+               "\"genPasses\":%llu,\"genGraphMs\":%.1f,\"genExpertMs\":%.1f,\"genPrepMs\":%.1f,\"genReadMs\":%.1f,"
+               "\"genMatMulMs\":%.1f,\"genAttnMs\":%.1f,\"genOtherMs\":%.1f,\"genGapMs\":%.1f}\n",
+            (unsigned long long) g_ec.hits, (unsigned long long) g_ec.misses, (unsigned long long) g_ec_passthrough,
+            g_ec_read_bytes / 1048576.0, g_ec.used / 1048576.0, g_ec.budget / 1048576.0,
+            g_ec.requested / 1048576.0, g_ec.avail / 1048576.0, g_ec.n_tensors, pread_tensors,
+            layer, g_ec_n_layers, (long long) tokens,
+            (unsigned long long) g_ec_prefetched, (unsigned long long) g_ec_prefetch_used,
+            (unsigned long long) g_ec_prefetch_late, (unsigned long long) g_ec_prefetch_wasted,
+            (unsigned long long) g_ec_gen_graphs, g_ec_time[GGML_EC_T_GRAPH] / 1e6, g_ec_time[GGML_EC_T_EXPERTS] / 1e6,
+            g_ec_time[GGML_EC_T_PREP] / 1e6, g_ec_time[GGML_EC_T_READS] / 1e6, g_ec_time[GGML_EC_T_MATMUL] / 1e6,
+            g_ec_time[GGML_EC_T_ATTN] / 1e6, g_ec_time[GGML_EC_T_OTHER] / 1e6, g_ec_time[GGML_EC_T_GAP] / 1e6);
+    fclose(f);
+    rename(tmp, path);
+}
+
+// Above this many tokens in a batch the op is prompt processing: nearly every
+// expert is needed once and not again until the next batch, so caching them
+// would only push out the ones generation keeps reusing.
+#define GGML_EC_PASSTHROUGH_TOKENS 16
+
+// Fills ptrs[a] for every expert a with counts[a] > 0: the cached copy, or
+// the mapped weights when passing through or the cache is full. Returns
+// false when the cache is not used for this tensor (ptrs untouched). src1 is
+// the op's input, the layer's router input for its first expert op.
+static bool ggml_ec_prepare(const struct ggml_tensor * src0, const struct ggml_tensor * src1, const int64_t * counts,
+                            int64_t n_tokens, const char ** ptrs) {
+    const size_t budget = ggml_ec_budget();
+    if (budget == 0) {
+        if (g_ec.n_tensors > 0) {
+            ggml_cpu_expert_cache_clear();
+        }
+        return false;
+    }
+    // only whole, contiguous expert slices
+    if (src0->ne[2] < 2 || src0->nb[2] != src0->nb[1]*src0->ne[1] || src0->nb[3] != src0->nb[2]*src0->ne[2]) {
+        return false;
+    }
+
+    ggml_critical_section_start();
+    if (budget != g_ec.requested) {
+        // first use since load (or a new request): everything else is
+        // allocated by now
+        g_ec.requested = budget;
+        g_ec.budget = ggml_ec_effective_budget(budget);
+        ggml_ec_make_room(0);
+    }
+    ggml_ec_release_pending();
+    g_ec_n_reads = 0;
+    g_ec_n_waits = 0;
+    struct ggml_ec_tensor * t = ggml_ec_find(src0, true);
+    if (!t) {
+        ggml_critical_section_end();
+        return false;
+    }
+    const bool first_of_layer = t->layer >= 0 && t->layer != g_ec_last_layer;
+    if (t->layer >= 0) {
+        if (t->layer + 1 > g_ec_n_layers) {
+            g_ec_n_layers = t->layer + 1;
+        }
+        if (t->layer < g_ec_last_layer ||
+            (t->layer > g_ec_last_layer && n_tokens > GGML_EC_PASSTHROUGH_TOKENS)) {
+            ggml_ec_write_stats(t->layer, n_tokens);
+        }
+        g_ec_last_layer = t->layer;
+    }
+    const uint64_t serial = ++g_ec.serial;
+    const int n_as = t->n;
+    const bool passthrough = n_tokens > GGML_EC_PASSTHROUGH_TOKENS;
+    if (!passthrough) {
+        g_ec_graph_gen = true;
+    }
+
+    // request every missing slice at once, this tensor's and the layer's
+    // siblings' (which run next with the same experts), before reading any
+    for (int a = 0; a < n_as; a++) {
+        if (counts[a] == 0) {
+            continue;
+        }
+        t->e[a].pin = serial;
+        if (!t->e[a].data) {
+            ggml_ec_prefetch(t, a*t->slice, t->slice);
+        }
+    }
+    for (int i = 0; t->layer >= 0 && i < g_ec.n_tensors; i++) {
+        struct ggml_ec_tensor * s = &g_ec.t[i];
+        if (s == t || s->buffer != t->buffer || s->n != n_as) {
+            continue;
+        }
+        if (s->layer == t->layer) {
+            for (int a = 0; a < n_as; a++) {
+                if (counts[a] > 0 && !s->e[a].data) {
+                    ggml_ec_prefetch(s, a*s->slice, s->slice);
+                } else if (counts[a] > 0) {
+                    s->e[a].used = ++g_ec.tick; // runs next: not for a prefetch to evict
+                }
+            }
+        } else if (passthrough && s->layer == t->layer + 1) {
+            // prompt processing needs nearly all of the next layer too: read
+            // it while this one computes
+            ggml_ec_prefetch(s, 0, s->slice * (size_t) s->n);
+        }
+    }
+
+    for (int a = 0; a < n_as; a++) {
+        if (counts[a] == 0) {
+            continue;
+        }
+        struct ggml_ec_entry * e = &t->e[a];
+        const char * mapped = (const char *) t->base + a*t->slice;
+        if (e->data) {
+            g_ec.hits++;
+            if (e->prefetched) {
+                g_ec_prefetch_used++;
+                e->prefetched = false;
+            }
+            int queued = GGML_EC_QUEUED;
+            if (atomic_compare_exchange_strong_explicit(&e->state, &queued, GGML_EC_READING,
+                                                        memory_order_acquire, memory_order_relaxed)) {
+                // no reader has started it: read it with the op's threads
+                g_ec_prefetch_late++;
+                ggml_ec_queue(t, a, e->data, e);
+            } else if (queued == GGML_EC_READING && g_ec_n_waits < GGML_EC_MAX_READS) {
+                g_ec_prefetch_late++;
+                g_ec_waits[g_ec_n_waits++] = e;
+            } else if (queued == GGML_EC_READING) {
+                // no room to note it: wait now
+                while (atomic_load_explicit(&e->state, memory_order_acquire) != GGML_EC_READY) {
+                    sched_yield();
+                }
+            }
+        } else if (passthrough && g_ec.used + t->slice > g_ec.budget) {
+            // no room without evicting: read this once, into a buffer
+            // freed at the next op (or straight from the mapping)
+            g_ec_passthrough++;
+            g_ec_read_bytes += t->slice;
+            if (g_ec_n_pending < GGML_EC_MAX_PENDING) {
+                void * buf = t->fd >= 0 ? malloc(t->slice) : NULL;
+                if (buf) {
+                    ggml_ec_queue(t, a, buf, NULL);
+                }
+                g_ec_pending[g_ec_n_pending].p = mapped;
+                g_ec_pending[g_ec_n_pending].n = t->slice;
+                g_ec_pending[g_ec_n_pending].buf = buf;
+                g_ec_n_pending++;
+                if (buf) {
+                    e->used = ++g_ec.tick;
+                    ptrs[a] = (const char *) buf;
+                    continue;
+                }
+            }
+        } else {
+            // generation evicts the least recently used; prompt processing
+            // only fills free room, which warms an empty cache
+            g_ec.misses++;
+            g_ec_read_bytes += t->slice;
+            if ((passthrough || ggml_ec_make_room(t->slice)) && (e->data = malloc(t->slice)) != NULL) {
+                // the copy is what is read from now on
+                ggml_ec_queue(t, a, e->data, NULL);
+                g_ec.used += t->slice;
+            }
+        }
+        e->used = ++g_ec.tick;
+        ptrs[a] = e->data ? (const char *) e->data : mapped;
+    }
+    // generation: read the next layer's likely experts while this one runs
+    if (first_of_layer && !passthrough && src1 && ggml_ec_prefetch_threads() > 0) {
+        ggml_ec_prefetch_next(t, src1);
+    }
+    ggml_critical_section_end();
+    return true;
+}
