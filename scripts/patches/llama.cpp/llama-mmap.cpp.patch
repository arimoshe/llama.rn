+#if defined(_POSIX_MAPPED_FILES) && defined(__linux__)
+// Whether reading a whole file in up front (MAP_POPULATE, MADV_WILLNEED)
+// fits in the memory available. A model larger than that is read in full
+// while evicting its own pages, and on Android the low-memory killer ends the
+// process; left unpopulated, pages are read when first touched, which also
+// lets a mixture-of-experts model stream its experts from storage.
+// LLAMA_MMAP_PREFETCH=0 or 1 forces either.
+static bool llama_mmap_prefetch_fits(size_t size) {
+    if (const char * env = getenv("LLAMA_MMAP_PREFETCH")) {
+        return strcmp(env, "0") != 0;
+    }
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (!f) {
+        return true;
+    }
+    char line[256];
+    unsigned long long avail_kb = 0;
+    bool found = false;
+    while (fgets(line, sizeof(line), f)) {
+        if (sscanf(line, "MemAvailable: %llu kB", &avail_kb) == 1) {
+            found = true;
+            break;
+        }
+    }
+    fclose(f);
+    if (!found) {
+        return true;
+    }
+    // keep a margin for the context, compute buffers and everything else
+    const unsigned long long margin = 512ull * 1024 * 1024;
+    return (unsigned long long) size + margin <= avail_kb * 1024;
+}
+#endif
