# The IP-Adapter build (sd15-pixel-ip-npu.yml). CHARACTERS and SCENES take
# that many lines of characters.txt and scenes.txt; STEPS is the Euler steps
# per drawing (the app draws 20). The smoke run (2/2/2) compiled both models
# in ~40 min; this is 48 drawings x 20 steps, ~1920 calibration samples.
CHARACTERS=16
SCENES=32
STEPS=20
# Run 38845305782 drew the calibration data, then quantizing all 1920 samples
# ran past 5 h (over 10 s a sample) and out of the job's time: reuse its data
# and calibrate on 600 of them, drawn at random.
CALIB_RUN_ID=38845305782
QUANT_SAMPLES=600
PUBLISH=1
TAG=sd15-liberte-pixelartredmond-ip-8elite-w8a16-v1
