# The IP-Adapter build (sd15-pixel-ip-npu.yml). CHARACTERS and SCENES take
# that many lines of characters.txt and scenes.txt; STEPS is the Euler steps
# per drawing (the app draws 20). The smoke run (2/2/2) compiled both models
# in ~40 min; this is 48 drawings x 20 steps, ~1920 calibration samples.
CHARACTERS=16
SCENES=32
STEPS=20
PUBLISH=1
